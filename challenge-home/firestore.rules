rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de productos: lectura y escritura abiertas. El panel /admin
    // no tiene login — quien sepa hablar directo con la API de Firestore
    // podría escribir acá igual, pero para un catálogo sin datos sensibles
    // está bien así.
    match /challenge_productos/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categorías del catálogo: mismo criterio que challenge_productos.
    match /challenge_categorias/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Registro interno de ventas: no está en ningún menú del sitio, pero
    // igual que el resto, no tiene protección a nivel de reglas (el PIN
    // protege la pantalla, no la base en sí).
    match /challenge_ventas/{saleId} {
      allow read: if true;
      allow write: if true;
    }

    // Auditoría de cambios manuales de stock (motivo + firma), generada
    // automáticamente desde /admin. No se edita ni se borra, solo se crea.
    match /challenge_stock_log/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Todo lo demás en esta base queda bloqueado por las dudas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
